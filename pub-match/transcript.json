 "phrases": [
  {
   "start": 0.0,
   "end": 2.81,
   "text": "Ga, le marché ce soir, on y va avec ta voiture ?"
  },
  {
   "start": 3.07,
   "end": 4.05,
   "text": "Ma voiture ?"
  },
  {
   "start": 4.53,
   "end": 7.5,
   "text": "Pour passer deux heures dans les bouchons et une heure à chercher une place ?"
  },
  {
   "start": 7.87,
   "end": 10.0,
   "text": "Donc on regarde à la télé comme des vieux."
  },
  {
   "start": 10.34,
   "end": 10.69,
   "text": "Non."
  },
  {
   "start": 11.2,
   "end": 12.47,
   "text": "On y va comme des patrons."
  },
  {
   "start": 12.89,
   "end": 13.35,
   "text": "Comment ça ?"
  },
  {
   "start": 13.67,
   "end": 14.39,
   "text": "Chauffeur privé"
  },
  {
   "start": 14.86,
   "end": 16.75,
   "text": "Il nous dépose devant, il nous attend."
  },
  {
   "start": 17.05,
   "end": 17.65,
   "text": "Ils nous ramè"
  },
  {
   "start": 17.94,
   "end": 19.59,
   "text": "Et après le match avec la foule."
  },
  {
   "start": 19.87,
   "end": 21.31,
   "text": "Il nous attend au point qu'on a"
  },
  {
   "start": 21.65,
   "end": 22.61,
   "text": "Pas de parking à chercher."
  },
  {
   "start": 23.0,
   "end": 24.54,
   "text": "Pas de taxi à supplier à minuit."
  },
  {
   "start": 24.82,
   "end": 30.81,
   "text": "Alors ce soir, on chante jusqu'à la dernière minute ! Toi, tu chantes même quand on perd."
  }
 ]
