 "phrases": [
  {
   "start": 0.0,
   "end": 0.75,
   "text": "Les filles !"
  },
  {
   "start": 1.03,
   "end": 1.62,
   "text": "samedi"
  },
  {
   "start": 1.94,
   "end": 5.78,
   "text": "À quoi, bon appriso, le marché des fleurs et on finit au starant de coiffure"
  },
  {
   "start": 6.05,
   "end": 9.76,
   "text": "Et qui porte les sacs ? Parce que moi je vais acheter beaucoup !"
  },
  {
   "start": 10.04,
   "end": 10.35,
   "text": "*soup"
  },
  {
   "start": 10.86,
   "end": 11.96,
   "text": "et on se déplace comment?"
  },
  {
   "start": 12.46,
   "end": 13.27,
   "text": "4 taxis"
  },
  {
   "start": 13.57,
   "end": 14.6,
   "text": "Tâtre négociation"
  },
  {
   "start": 14.94,
   "end": 16.25,
   "text": "4 fois à tomber au soleil"
  },
  {
   "start": 16.63,
   "end": 16.99,
   "text": "Non."
  },
  {
   "start": 17.54,
   "end": 18.38,
   "text": "Un seul chauffeur."
  },
  {
   "start": 18.91,
   "end": 19.4,
   "text": "5"
  },
  {
   "start": 19.98,
   "end": 21.16,
   "text": "et nous attend à chaque arrêt."
  },
  {
   "start": 21.58,
   "end": 23.08,
   "text": "5 heures de chauffeur privé"
  },
  {
   "start": 23.58,
   "end": 25.34,
   "text": "Sandrine, on n'est pas des ministres"
  },
  {
   "start": 25.72,
   "end": 26.65,
   "text": "Paqueko en promo."
  },
  {
   "start": 27.01,
   "end": 28.42,
   "text": "2000h des 5h"
  },
  {
   "start": 28.82,
   "end": 29.43,
   "text": "10 000 francs"
  },
  {
   "start": 29.71,
   "end": 32.4,
   "text": "10 000 divisé par 3"
  },
  {
   "start": 32.66,
   "end": 34.49,
   "text": "-3 500 chacune !"
  },
  {
   "start": 34.77,
   "end": 40.92,
   "text": "et les sacs restent dans le coffre. Alors je peux acheter encore plus ! Muriel, non !"
  }
