 "phrases": [
  {
   "start": 0.3,
   "end": 2.47,
   "text": "Clarice pensait qu'un chauffeur privé."
  },
  {
   "start": 2.83,
   "end": 4.25,
   "text": "c'était pour les ministres."
  },
  {
   "start": 5.04,
   "end": 5.28,
   "text": "puis"
  },
  {
   "start": 5.72,
   "end": 6.87,
   "text": "Elle a demandé le prix."
  },
  {
   "start": 7.83,
   "end": 8.41,
   "text": "Softly."
  },
  {
   "start": 9.27,
   "end": 10.77,
   "text": "3000 francs de l'heure."
  },
  {
   "start": 11.43,
   "end": 13.47,
   "text": "voiture et chauffeur compris."
  },
  {
   "start": 14.72,
   "end": 15.24,
   "text": "samedi"
  },
  {
   "start": 15.84,
   "end": 16.41,
   "text": "Elle a fait."
  },
  {
   "start": 16.67,
   "end": 18.11,
   "text": "toutes ces courses d'endroits-"
  },
  {
   "start": 18.81,
   "end": 20.54,
   "text": "sans attendre un seul taxi."
  },
